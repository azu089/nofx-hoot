{
  "name": "hoot",
  "version": "1.0.0",
  "private": true,
  "description": "Hoot - AI Quantitative Trading Platform",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter api exec tsc --noEmit && pnpm --filter web exec next build",
    "typecheck:api": "pnpm --filter api exec tsc --noEmit",
    "typecheck:web": "pnpm --filter web exec next build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "v0:generate": "tsx scripts/v0/generate.ts",
    "v0:fetch": "tsx scripts/v0/fetch.ts"
  },
  "keywords": [
    "quantitative",
    "trading",
    "crypto",
    "defi"
  ],
  "author": "Hoot Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "v0-sdk": "^0.16.1"
  },
  "devDependencies": {
    "playwright": "^1.58.1",
    "tsx": "^4.21.0"
  }
}
