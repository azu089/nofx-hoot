{
    "strategy": "HootTestStrategy",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 10,
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_sync_config": { "enableRateLimit": true },
        "ccxt_async_config": { "enableRateLimit": true },
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [{ "method": "StaticPairList" }],
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "webhook": {
        "enabled": true,
        "url": "http://localhost:4001/api/signals/webhook",
        "webhookentry": {
            "strategy": "{strategy}",
            "symbol": "{pair}",
            "side": "buy",
            "price": "{current_rate}",
            "type": "entry",
            "tag": "{enter_tag}"
        },
        "webhookexit": {
            "strategy": "{strategy}",
            "symbol": "{pair}",
            "side": "sell",
            "price": "{current_rate}",
            "type": "exit",
            "tag": "{exit_tag}"
        },
        "webhookentrycancel": null,
        "webhookexitcancel": null,
        "webhookstatus": null
    },
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "",
        "ws_token": "",
        "CORS_origins": [],
        "username": "freqtrade",
        "password": "freqtrade"
    },
    "bot_name": "HootTestBot",
    "initial_state": "running",
    "force_entry_enable": true,
    "internals": {
        "process_throttle_secs": 5
    },
    "dataformat_ohlcv": "feather",
    "dataformat_trades": "feather"
}
