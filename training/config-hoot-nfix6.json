        "password": "hoot123",
        "jwt_secret_key": "hootsecretkey3"
    },
    "webhook": {
        "enabled": true,
        "url": "http://localhost:4001/api/signals/webhook",
        "webhookentry": {
            "strategy": "NostalgiaForInfinityX6_MOD",
            "symbol": "{pair}",
            "side": "buy",
            "action": "entry_long",
            "price": "{current_rate}"
        },
        "webhookexit": {
            "strategy": "NostalgiaForInfinityX6_MOD",
            "symbol": "{pair}",
            "side": "sell",
            "action": "exit_long",
            "price": "{current_rate}"
        },
        "webhookentrycancel": null,
        "webhookexitcancel": null,
        "webhookentryshort": {
            "strategy": "NostalgiaForInfinityX6_MOD",
            "symbol": "{pair}",
            "side": "sell",
            "action": "entry_short",
            "price": "{current_rate}"
