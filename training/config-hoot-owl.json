{
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 150,
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "dry_run_wallet": 10000,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 5,
        "exit": 5,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "enableRateLimit": true
        },
        "ccxt_async_config": {
            "enableRateLimit": true
        },
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8091,
        "verbosity": "error",
        "username": "hoot",
        "password": "hoot123",
        "jwt_secret_key": "hootsecretkey2"
    },
    "webhook": {
        "enabled": true,
        "url": "http://api:4001/api/signals/webhook",
        "webhookentry": {
            "strategy": "HootOwlV1",
            "symbol": "{pair}",
            "side": "buy",
            "action": "entry_long",
            "price": "{current_rate}"
        },
        "webhookexit": {
            "strategy": "HootOwlV1",
            "symbol": "{pair}",
            "side": "sell",
            "action": "exit_long",
            "price": "{current_rate}"
        },
        "webhookentrycancel": null,
        "webhookexitcancel": null,
        "webhookentryshort": {
            "strategy": "HootOwlV1",
            "symbol": "{pair}",
            "side": "sell",
            "action": "entry_short",
            "price": "{current_rate}"
        },
        "webhookexitshort": {
            "strategy": "HootOwlV1",
            "symbol": "{pair}",
            "side": "buy",
            "action": "exit_short",
            "price": "{current_rate}"
        }
    },
    "bot_name": "HootOwl",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    }
}
