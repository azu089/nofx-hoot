# ==============================================
# HOOT 环境变量配置
# 复制此文件为 .env 并填入实际值
# ==============================================

# === 数据库 ===
DATABASE_URL=postgresql://hoot:your_password@localhost:5433/hoot
DB_PASSWORD=your_secure_password

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# === JWT 认证 ===
# 生成命令: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# === 管理员 JWT 密钥（与用户 JWT 分离） ===
# 生成命令: openssl rand -hex 32
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_different_from_user

# === API 服务 ===
API_PORT=4001
NODE_ENV=development

# === Web 服务 ===
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4001

# === 交易所 API 加密密钥 ===
# 生成命令: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_encryption_key_here
# 加密盐（用于密钥派生，首次部署后不可更改）
# 生成命令: openssl rand -hex 16
ENCRYPTION_SALT=your_encryption_salt_here

# === Webhook 签名密钥 ===
# 生成命令: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret_key

# === Freqtrade ===
# Freqtrade API Server 凭证（生产环境通过 docker-compose 环境变量注入）
FT_API_USERNAME=hoot
FT_API_PASSWORD=your_strong_freqtrade_password
FT_JWT_SECRET=your_freqtrade_jwt_secret
FT_JWT_SECRET_OWL=your_freqtrade_owl_jwt_secret
# Freqtrade 健康监控（多实例配置，格式: name:url,name:url）
FREQTRADE_INSTANCES=HootTestStrategy:http://localhost:8090,HootOwlV1:http://localhost:8091

# === 链上监听 ===
# 生产环境必须启用，否则链上充值无法自动到账
ENABLE_BLOCKCHAIN_LISTENER=true

# BSC（必须）
BSC_RPC_URL=https://bsc-dataseed1.binance.org
BSC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# 兼容旧配置
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
HOOT_CONTRACT_ADDRESS=

# ETH（可选，配置后自动启用 ERC20 充值监听）
ETH_RPC_URL=
ETH_USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Polygon（可选，配置后自动启用 Polygon 充值监听）
POLYGON_RPC_URL=
POLYGON_USDT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# TRON（可选，配置后自动启用 TRC20 充值监听）
# TronGrid API: https://www.trongrid.io/
TRON_API_URL=
TRON_API_KEY=
TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# === HD 钱包（充值地址派生） ===
# 用于生成用户充值地址。生产环境务必妥善保管！
# 生成命令: node -e "console.log(require('ethers').Wallet.createRandom().mnemonic.phrase)"
HD_WALLET_MNEMONIC=

# === 热钱包（提现 + 归集目标地址） ===
# 一把私钥同时服务所有 EVM 链（BSC/ETH/Polygon），地址相同
# TRON 热钱包地址从同一私钥自动派生（T... 格式），无需单独配置
WITHDRAW_WALLET_PRIVATE_KEY=
HOT_WALLET_ADDRESS=

# === TRON 链上交易参数 ===
# TRC20 转账手续费上限，单位 SUN (1 TRX = 1,000,000 SUN)，默认 30,000,000 (30 TRX)
TRON_FEE_LIMIT=30000000
# TRON 归集时为子地址充值的 TRX Gas 费，单位 SUN，默认 30,000,000 (30 TRX)
TRON_SWEEP_GAS_AMOUNT=30000000

# === 提现风控配置 ===
# 小额自动提现阈值（USDT），低于此金额自动执行
WITHDRAW_AUTO_THRESHOLD=500
# 每日自动提现总额上限（USDT）
WITHDRAW_DAILY_AUTO_LIMIT=5000
# 每用户每日提现次数上限
WITHDRAW_USER_DAILY_LIMIT=3

# === HOOT 代币价格（兑换用） ===
# 1 HOOT = ? USDT，用于钱包内 USDT<->HOOT 兑换
HOOT_PRICE_USDT=0.15

# === 通知服务（可选） ===
NOVU_API_KEY=
NOVU_APP_ID=

# === Telegram 用户 Bot ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TG Bot 调用后端 API 的共享密钥（TG Bot 和后端必须一致）
# 生成命令: openssl rand -hex 32
TELEGRAM_BOT_API_SECRET=your_telegram_bot_api_secret
# 用户 Bot HTTP 服务地址（后端调用发送用户通知）
TELEGRAM_BOT_URL=http://localhost:4002

# === Telegram 管理员 Bot（独立于用户 Bot） ===
# 通过 @BotFather 创建另一个 Bot，Token 不同于用户 Bot
ADMIN_TELEGRAM_BOT_TOKEN=your_admin_telegram_bot_token
# 管理员 TG ID 列表（逗号分隔，支持多个管理员）
ADMIN_TG_IDS=123456789,987654321
# 管理员 Bot HTTP 端口
ADMIN_BOT_HTTP_PORT=4003
# 管理员 Bot 内部服务地址（后端调用发送提现审核通知）
ADMIN_BOT_URL=http://localhost:4003

# === 邮件服务 ===
RESEND_API_KEY=

# === Sentry 错误追踪（推荐，从 sentry.io 获取 DSN） ===
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# === S3 备份配置（生产环境必填） ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=hoot-backups
S3_REGION=ap-southeast-1
