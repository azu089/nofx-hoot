# QuantFi 环境变量配置
# 复制此文件为 .env 并填入实际值

# ============================================
# 数据库配置
# ============================================
DATABASE_URL="postgresql://quantfi:quantfi123@localhost:5433/quantfi"

# ============================================
# Redis 配置
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# JWT 认证
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ============================================
# 服务端口
# ============================================
API_PORT=4001
WEB_PORT=3001

# ============================================
# Freqtrade 信号引擎
# ============================================
FREQTRADE_API_URL="http://localhost:8080"
FREQTRADE_JWT_SECRET="your-freqtrade-jwt-secret"
FREQTRADE_WEBHOOK_SECRET="your-webhook-secret"

# ============================================
# Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ============================================
# Web3 / 区块链
# ============================================
NEXT_PUBLIC_WALLETCONNECT_ID="your-walletconnect-project-id"
NEXT_PUBLIC_CHAIN_ID="56"

# BSC 主网 RPC
BSC_RPC_URL="https://bsc-dataseed.binance.org/"
# BSC 测试网 RPC
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545/"

# 合约部署私钥（仅开发测试用，生产环境禁止明文存储）
DEPLOYER_PRIVATE_KEY=""

# ============================================
# 交易所 API（测试用）
# ============================================
# Binance
BINANCE_API_KEY=""
BINANCE_SECRET=""

# OKX
OKX_API_KEY=""
OKX_SECRET=""
OKX_PASSPHRASE=""

# Bybit
BYBIT_API_KEY=""
BYBIT_SECRET=""

# ============================================
# Novu 通知服务
# ============================================
NOVU_API_KEY=""
NOVU_APPLICATION_IDENTIFIER=""

# ============================================
# Sentry 错误追踪（Phase 8）
# ============================================
SENTRY_DSN=""

# ============================================
# 加密密钥（API Key 加密存储）
# ============================================
# 32 字节（256 位）AES 密钥，可用 openssl rand -hex 32 生成
ENCRYPTION_KEY=""

# ============================================
# NextAuth 配置
# ============================================
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# ============================================
# 邮件服务（可选）
# ============================================
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
