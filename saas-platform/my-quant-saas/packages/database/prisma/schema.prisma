// QuantFi SaaS Platform Database Schema
// Merged from original project with next-forge structure

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  relationMode = "prisma"
}

// ============================================
// User & Authentication
// ============================================

/// 用户表 - 核心用户信息
/// This table contains check constraints and requires additional setup for migrations.
model users {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                String    @unique @db.VarChar(255)
  password_hash        String    @db.VarChar(255)
  two_factor_enabled   Boolean   @default(false)
  two_factor_secret    String?   @db.VarChar(64)
  vip_level            Int       @default(0) @db.SmallInt
  vip_expires_at       DateTime? @db.Timestamptz(6)
  agent_id             String?   @db.Uuid
  invite_code          String?   @unique @db.VarChar(20)
  device_fingerprints  Json?     @default("[]")
  status               String    @default("active") @db.VarChar(20)
  last_login_at        DateTime? @db.Timestamptz(6)
  last_login_ip        String?   @db.Inet
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  admin_audit_logs                           admin_audit_logs[]
  agent_commissions                          agent_commissions[]
  api_keys                                   api_keys[]
  backtests                                  backtests[]
  billing_logs                               billing_logs[]
  deposits_deposits_reviewed_byTousers       deposits[]              @relation("deposits_reviewed_byTousers")
  deposits_deposits_user_idTousers           deposits[]              @relation("deposits_user_idTousers")
  instance_backups                           instance_backups[]
  instances                                  instances[]
  stakes                                     stakes[]
  token_orders                               token_orders[]
  trade_history                              trade_history[]
  user_strategy_configs                      user_strategy_configs[]
  agents                                     agents?                 @relation(fields: [agent_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wallets                                    wallets?
  withdrawals_withdrawals_reviewed_byTousers withdrawals[]           @relation("withdrawals_reviewed_byTousers")
  withdrawals_withdrawals_user_idTousers     withdrawals[]           @relation("withdrawals_user_idTousers")

  @@index([agent_id], map: "idx_users_agent")
  @@index([email], map: "idx_users_email")
  @@index([status], map: "idx_users_status")
  @@index([vip_level], map: "idx_users_vip_level")
}

// ============================================
// Wallet & Finance
// ============================================

/// 钱包表 - 用户资产管理
/// This table contains check constraints and requires additional setup for migrations.
model wallets {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String   @unique @db.Uuid
  usdt_balance   Decimal  @default(0) @db.Decimal(18, 8)
  usdt_frozen    Decimal  @default(0) @db.Decimal(18, 8)
  points_balance Decimal  @default(0) @db.Decimal(18, 8)
  points_frozen  Decimal  @default(0) @db.Decimal(18, 8)
  token_balance  Decimal  @default(0) @db.Decimal(18, 8)
  token_locked   Decimal  @default(0) @db.Decimal(18, 8)
  token_vesting  Decimal  @default(0) @db.Decimal(18, 8)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

/// 充值记录
/// This table contains check constraints and requires additional setup for migrations.
model deposits {
  id                                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                           String    @db.Uuid
  amount                            Decimal   @db.Decimal(18, 8)
  currency                          String    @default("USDT") @db.VarChar(10)
  method                            String    @db.VarChar(30)
  chain                             String?   @db.VarChar(20)
  from_address                      String?   @db.VarChar(100)
  tx_hash                           String?   @db.VarChar(100)
  block_number                      BigInt?
  confirmations                     Int?      @default(0)
  proof_image_url                   String?   @db.VarChar(500)
  reviewed_by                       String?   @db.Uuid
  reviewed_at                       DateTime? @db.Timestamptz(6)
  status                            String    @default("pending") @db.VarChar(20)
  reject_reason                     String?
  created_at                        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime  @default(now()) @db.Timestamptz(6)
  users_deposits_reviewed_byTousers users?    @relation("deposits_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  users_deposits_user_idTousers     users     @relation("deposits_user_idTousers", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([created_at], map: "idx_deposits_created")
  @@index([status], map: "idx_deposits_status")
  @@index([user_id], map: "idx_deposits_user")
}

/// 提现记录
/// This table contains check constraints and requires additional setup for migrations.
model withdrawals {
  id                                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                              String    @db.Uuid
  amount                               Decimal   @db.Decimal(18, 8)
  currency                             String    @default("USDT") @db.VarChar(10)
  fee                                  Decimal   @default(0) @db.Decimal(18, 8)
  chain                                String    @db.VarChar(20)
  to_address                           String    @db.VarChar(100)
  tx_hash                              String?   @db.VarChar(100)
  status                               String    @default("pending") @db.VarChar(20)
  reviewed_by                          String?   @db.Uuid
  reviewed_at                          DateTime? @db.Timestamptz(6)
  reject_reason                        String?
  two_factor_verified                  Boolean   @default(false)
  created_at                           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime  @default(now()) @db.Timestamptz(6)
  users_withdrawals_reviewed_byTousers users?    @relation("withdrawals_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  users_withdrawals_user_idTousers     users     @relation("withdrawals_user_idTousers", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([created_at], map: "idx_withdrawals_created")
  @@index([status], map: "idx_withdrawals_status")
  @@index([user_id], map: "idx_withdrawals_user")
}

/// 计费日志 - 幂等性保障
model billing_logs {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String   @db.Uuid
  unique_order_id String   @unique @db.VarChar(100)
  billing_type    String   @db.VarChar(30)
  amount          Decimal  @db.Decimal(18, 8)
  currency        String   @default("USDT") @db.VarChar(10)
  reference_type  String?  @db.VarChar(50)
  reference_id    String?  @db.Uuid
  description     String?
  status          String   @default("completed") @db.VarChar(20)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users    @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([created_at], map: "idx_billing_logs_created")
  @@index([billing_type], map: "idx_billing_logs_type")
  @@index([user_id], map: "idx_billing_logs_user")
}

// ============================================
// VPS Instance Management
// ============================================

/// VPS 实例
model instances {
  id                                                                   String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                                              String                  @db.Uuid
  droplet_id                                                           String?                 @db.VarChar(50)
  region                                                               String                  @default("sgp1") @db.VarChar(20)
  size                                                                 String                  @default("s-1vcpu-1gb") @db.VarChar(20)
  ip_address                                                           String?                 @db.Inet
  status                                                               String                  @default("pending") @db.VarChar(20)
  last_heartbeat                                                       DateTime?               @db.Timestamptz(6)
  cpu_usage                                                            Decimal?                @db.Decimal(5, 2)
  memory_usage                                                         Decimal?                @db.Decimal(5, 2)
  provisioned_at                                                       DateTime?               @db.Timestamptz(6)
  destroyed_at                                                         DateTime?               @db.Timestamptz(6)
  destroy_reason                                                       String?                 @db.VarChar(100)
  created_at                                                           DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                                           DateTime                @default(now()) @db.Timestamptz(6)
  instance_backups_instance_backups_instance_idToinstances             instance_backups[]      @relation("instance_backups_instance_idToinstances")
  instance_backups_instance_backups_restored_to_instance_idToinstances instance_backups[]      @relation("instance_backups_restored_to_instance_idToinstances")
  users                                                                users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  trade_history                                                        trade_history[]
  user_strategy_configs                                                user_strategy_configs[]

  @@index([last_heartbeat], map: "idx_instances_heartbeat")
  @@index([status], map: "idx_instances_status")
}

/// VPS 备份记录
model instance_backups {
  id                                                            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instance_id                                                   String     @db.Uuid
  user_id                                                       String     @db.Uuid
  backup_type                                                   String     @db.VarChar(20)
  s3_bucket                                                     String     @db.VarChar(100)
  s3_key                                                        String     @db.VarChar(500)
  file_size_bytes                                               BigInt?
  includes                                                      Json?      @default("[\"trades.sqlite\", \"config.json\"]")
  status                                                        String     @default("pending") @db.VarChar(20)
  error_message                                                 String?
  restored_to_instance_id                                       String?    @db.Uuid
  restored_at                                                   DateTime?  @db.Timestamptz(6)
  created_at                                                    DateTime   @default(now()) @db.Timestamptz(6)
  expires_at                                                    DateTime?  @db.Timestamptz(6)
  instances_instance_backups_instance_idToinstances             instances  @relation("instance_backups_instance_idToinstances", fields: [instance_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instances_instance_backups_restored_to_instance_idToinstances instances? @relation("instance_backups_restored_to_instance_idToinstances", fields: [restored_to_instance_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  users                                                         users      @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([instance_id], map: "idx_instance_backups_instance")
  @@index([status], map: "idx_instance_backups_status")
  @@index([user_id], map: "idx_instance_backups_user")
}

// ============================================
// Trading & Strategy
// ============================================

/// 交易策略
model strategies {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  owner_type            String                  @default("system") @db.VarChar(20)
  owner_id              String?                 @db.Uuid
  name                  String                  @db.VarChar(100)
  description           String?
  content               String
  config                Json?                   @default("{}")
  performance_stats     Json?                   @default("{\"live\": {\"win_rate\": 0, \"total_pnl\": 0, \"last_updated\": null, \"total_trades\": 0}, \"backtest\": {\"win_rate\": 0, \"max_drawdown\": 0, \"sharpe_ratio\": 0, \"total_trades\": 0, \"profit_factor\": 0}}")
  is_public             Boolean                 @default(false)
  is_active             Boolean                 @default(true)
  version               Int                     @default(1)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  backtests             backtests[]
  trade_history         trade_history[]
  user_strategy_configs user_strategy_configs[]

  @@index([owner_type, owner_id], map: "idx_strategies_owner")
}

/// 用户策略配置
/// This table contains check constraints and requires additional setup for migrations.
model user_strategy_configs {
  id                     String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                String     @db.Uuid
  strategy_id            String     @db.Uuid
  instance_id            String?    @db.Uuid
  stake_amount           Decimal    @default(100) @db.Decimal(18, 8)
  max_open_trades        Int        @default(3)
  leverage               Int        @default(1) @db.SmallInt
  stoploss               Decimal    @default(-0.1000) @db.Decimal(5, 4)
  trailing_stop          Boolean    @default(false)
  trailing_stop_positive Decimal?   @db.Decimal(5, 4)
  blacklist              Json?      @default("[]")
  custom_config          Json?      @default("{}")
  is_active              Boolean    @default(true)
  created_at             DateTime   @default(now()) @db.Timestamptz(6)
  updated_at             DateTime   @default(now()) @db.Timestamptz(6)
  instances              instances? @relation(fields: [instance_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  strategies             strategies @relation(fields: [strategy_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  users                  users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([instance_id], map: "idx_user_strategy_configs_instance")
  @@index([strategy_id], map: "idx_user_strategy_configs_strategy")
  @@index([user_id], map: "idx_user_strategy_configs_user")
}

/// 回测记录
model backtests {
  id               String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String     @db.Uuid
  strategy_id      String     @db.Uuid
  config           Json       @default("{\"pairs\": [\"BTC/USDT\", \"ETH/USDT\"], \"timerange\": \"20240101-20241231\", \"stake_amount\": 100, \"stake_currency\": \"USDT\"}")
  results          Json?
  total_trades     Int?
  win_rate         Decimal?   @db.Decimal(5, 2)
  profit_total     Decimal?   @db.Decimal(18, 8)
  profit_percent   Decimal?   @db.Decimal(8, 4)
  max_drawdown     Decimal?   @db.Decimal(8, 4)
  sharpe_ratio     Decimal?   @db.Decimal(8, 4)
  status           String     @default("pending") @db.VarChar(20)
  error_message    String?
  started_at       DateTime?  @db.Timestamptz(6)
  completed_at     DateTime?  @db.Timestamptz(6)
  duration_seconds Int?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
  strategies       strategies @relation(fields: [strategy_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  users            users      @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([created_at], map: "idx_backtests_created")
  @@index([status], map: "idx_backtests_status")
  @@index([strategy_id], map: "idx_backtests_strategy")
  @@index([user_id], map: "idx_backtests_user")
}

/// 交易历史
model trade_history {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String      @db.Uuid
  instance_id    String?     @db.Uuid
  strategy_id    String?     @db.Uuid
  exchange       String      @db.VarChar(50)
  symbol         String      @db.VarChar(30)
  side           String      @db.VarChar(10)
  order_type     String      @db.VarChar(20)
  entry_price    Decimal?    @db.Decimal(18, 8)
  exit_price     Decimal?    @db.Decimal(18, 8)
  quantity       Decimal     @db.Decimal(18, 8)
  leverage       Int?        @default(1) @db.SmallInt
  pnl            Decimal?    @db.Decimal(18, 8)
  pnl_percentage Decimal?    @db.Decimal(8, 4)
  gas_fee        Decimal?    @default(0) @db.Decimal(18, 8)
  status         String      @default("open") @db.VarChar(20)
  opened_at      DateTime    @default(now()) @db.Timestamptz(6)
  closed_at      DateTime?   @db.Timestamptz(6)
  sync_data      Json?       @default("{}")
  synced_at      DateTime?   @db.Timestamptz(6)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  instances      instances?  @relation(fields: [instance_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  strategies     strategies? @relation(fields: [strategy_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  users          users       @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([instance_id], map: "idx_trade_history_instance")
  @@index([opened_at], map: "idx_trade_history_opened")
  @@index([status], map: "idx_trade_history_status")
  @@index([symbol], map: "idx_trade_history_symbol")
  @@index([user_id], map: "idx_trade_history_user")
}

/// API Key 加密存储
model api_keys {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  exchange         String    @db.VarChar(50)
  label            String?   @db.VarChar(100)
  encrypted_blob   Bytes
  iv               Bytes
  auth_tag         Bytes
  permissions      Json?     @default("{\"spot\": false, \"futures\": true, \"withdraw\": false}")
  is_active        Boolean   @default(true)
  last_verified_at DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([exchange], map: "idx_api_keys_exchange")
  @@index([user_id], map: "idx_api_keys_user")
}

// ============================================
// GameFi & Token Economy
// ============================================

/// 质押记录
/// This table contains check constraints and requires additional setup for migrations.
model stakes {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String    @db.Uuid
  stake_type         String    @db.Char(1)
  amount             Decimal   @db.Decimal(18, 8)
  start_time         DateTime  @default(now()) @db.Timestamptz(6)
  lock_period_days   Int
  end_time           DateTime  @db.Timestamptz(6)
  weight_multiplier  Decimal   @default(1.00) @db.Decimal(5, 2)
  accumulated_reward Decimal   @default(0) @db.Decimal(18, 8)
  last_reward_at     DateTime? @db.Timestamptz(6)
  status             String    @default("active") @db.VarChar(20)
  early_unstake_at   DateTime? @db.Timestamptz(6)
  penalty_amount     Decimal?  @default(0) @db.Decimal(18, 8)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([end_time], map: "idx_stakes_end_time")
  @@index([status], map: "idx_stakes_status")
  @@index([stake_type], map: "idx_stakes_type")
  @@index([user_id], map: "idx_stakes_user")
}

/// Token 兑换订单
/// This table contains check constraints and requires additional setup for migrations.
model token_orders {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  points_spent     Decimal   @db.Decimal(18, 8)
  tokens_total     Decimal   @db.Decimal(18, 8)
  exchange_rate    Decimal   @db.Decimal(18, 8)
  vesting_mode     String    @default("standard") @db.VarChar(20)
  tokens_released  Decimal   @default(0) @db.Decimal(18, 8)
  tokens_pending   Decimal   @default(0) @db.Decimal(18, 8)
  tokens_burned    Decimal   @default(0) @db.Decimal(18, 8)
  vesting_start_at DateTime  @default(now()) @db.Timestamptz(6)
  vesting_end_at   DateTime? @db.Timestamptz(6)
  last_release_at  DateTime? @db.Timestamptz(6)
  status           String    @default("vesting") @db.VarChar(20)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status], map: "idx_token_orders_status")
  @@index([user_id], map: "idx_token_orders_user")
}

/// Token 销毁记录
/// This table contains check constraints and requires additional setup for migrations.
model token_burns {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  source_type  String   @db.VarChar(30)
  source_id    String?  @db.Uuid
  amount       Decimal  @db.Decimal(18, 8)
  tx_hash      String?  @db.VarChar(100)
  burn_address String?  @default("0x000000000000000000000000000000000000dEaD") @db.VarChar(100)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_token_burns_created")
  @@index([source_type, source_id], map: "idx_token_burns_source")
}

/// 收入分配记录
model revenue_distributions {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  period_start       DateTime @db.Timestamptz(6)
  period_end         DateTime @db.Timestamptz(6)
  total_revenue      Decimal  @db.Decimal(18, 8)
  operations_amount  Decimal  @db.Decimal(18, 8)
  buyback_amount     Decimal  @db.Decimal(18, 8)
  reserve_amount     Decimal  @db.Decimal(18, 8)
  buyback_executed   Boolean  @default(false)
  buyback_tx_hash    String?  @db.VarChar(100)
  tokens_bought      Decimal? @default(0) @db.Decimal(18, 8)
  tokens_burned      Decimal? @default(0) @db.Decimal(18, 8)
  tokens_distributed Decimal? @default(0) @db.Decimal(18, 8)
  status             String   @default("pending") @db.VarChar(20)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([period_start, period_end], map: "idx_revenue_distributions_period")
  @@index([status], map: "idx_revenue_distributions_status")
}

// ============================================
// Agent & Commission
// ============================================

/// 代理商
/// This table contains check constraints and requires additional setup for migrations.
model agents {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code              String              @unique @db.VarChar(20)
  name              String              @db.VarChar(100)
  email             String              @unique @db.VarChar(255)
  parent_agent_id   String?             @db.Uuid
  level             Int                 @default(1) @db.SmallInt
  commission_rate   Decimal             @default(0.1000) @db.Decimal(5, 4)
  total_users       Int                 @default(0)
  total_commission  Decimal             @default(0) @db.Decimal(18, 8)
  status            String              @default("active") @db.VarChar(20)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  agent_commissions agent_commissions[]
  agents            agents?             @relation("agentsToagents", fields: [parent_agent_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  other_agents      agents[]            @relation("agentsToagents")
  users             users[]

  @@index([code], map: "idx_agents_code")
  @@index([parent_agent_id], map: "idx_agents_parent")
}

/// 代理佣金记录
model agent_commissions {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agent_id          String    @db.Uuid
  user_id           String    @db.Uuid
  source_type       String    @db.VarChar(30)
  source_id         String?   @db.Uuid
  base_amount       Decimal   @db.Decimal(18, 8)
  commission_rate   Decimal   @db.Decimal(5, 4)
  commission_amount Decimal   @db.Decimal(18, 8)
  status            String    @default("pending") @db.VarChar(20)
  settled_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  agents            agents    @relation(fields: [agent_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([agent_id], map: "idx_agent_commissions_agent")
  @@index([status], map: "idx_agent_commissions_status")
  @@index([user_id], map: "idx_agent_commissions_user")
}

// ============================================
// Admin & System
// ============================================

/// 管理员审计日志
model admin_audit_logs {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  admin_id    String   @db.Uuid
  action      String   @db.VarChar(50)
  target_type String?  @db.VarChar(50)
  target_id   String?  @db.Uuid
  details     Json?    @default("{}")
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [admin_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([action], map: "idx_admin_audit_logs_action")
  @@index([admin_id], map: "idx_admin_audit_logs_admin")
  @@index([created_at], map: "idx_admin_audit_logs_created")
}

/// 公告
model announcements {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title         String    @db.VarChar(200)
  content       String
  type          String    @default("info") @db.VarChar(20)
  is_pinned     Boolean   @default(false)
  display_order Int       @default(0)
  start_at      DateTime  @default(now()) @db.Timestamptz(6)
  end_at        DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([start_at, end_at], map: "idx_announcements_active")
}

/// Schema 迁移记录
model schema_migrations {
  version     String   @id @db.VarChar(50)
  applied_at  DateTime @default(now()) @db.Timestamptz(6)
  description String?
}
