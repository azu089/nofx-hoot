# ==============================================
# HOOT API 环境变量配置
# ==============================================
# 复制此文件为 .env 并填入实际值
# 生产环境配置请参考 .env.production.example

# ==================== 基础配置 ====================

# 运行环境: development | production
NODE_ENV=development

# API 端口
API_PORT=4001

# ==================== 数据库 ====================

# PostgreSQL 连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://quantfi:quantfi123@localhost:5433/quantfi"

# ==================== Redis ====================

REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== 安全密钥 ====================

# JWT 密钥（用于用户认证）
# ⚠️ 生产环境必须修改！使用: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-in-production

# API Key 加密密钥（用于加密用户的交易所 API Key）
# ⚠️ 生产环境必须修改！使用: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-change-in-production

# Webhook 签名密钥（用于验证 Freqtrade 发来的信号）
# ⚠️ 生产环境必须修改！使用: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-change-in-production

# ==================== 区块链配置 ====================

# BSC/ETH 提现钱包私钥（热钱包）
# ⚠️ 极度敏感！仅存储小额资金用于自动提现
# 使用: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
WITHDRAW_WALLET_PRIVATE_KEY=

# 是否启用链上充值监听（生产环境必须 true）
ENABLE_BLOCKCHAIN_LISTENER=true

# BSC RPC 节点（必须）
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# 兼容旧配置
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# ETH RPC 节点（可选，启用后支持 ERC20 充值）
ETH_RPC_URL=
ETH_USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Polygon RPC 节点（可选，启用后支持 Polygon 充值）
POLYGON_RPC_URL=
POLYGON_USDT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# TRON TronGrid API（可选，启用后支持 TRC20 充值）
TRON_API_URL=
TRON_API_KEY=
TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# 充值监听地址（收款地址）- 已弃用，使用 HD 钱包派生
DEPOSIT_WALLET_ADDRESS=

# ==================== Freqtrade ====================

FREQTRADE_API_URL=http://localhost:8080
FREQTRADE_JWT_SECRET=your-freqtrade-jwt-secret

# ==================== 邮件服务 ====================

# Resend API Key
# 从 https://resend.com/api-keys 获取
RESEND_API_KEY=re_xxxxxxxxxx

# 发件人邮箱（需要在 Resend 中验证域名）
EMAIL_FROM=noreply@hoot.cool

# ==================== Telegram Bot ====================

# Bot Token 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# TG Bot HTTP API 地址
TG_BOT_API_URL=http://localhost:4002

# ==================== 第三方服务 ====================

# DeepL 翻译 API
# 从 https://www.deepl.com/account/summary 获取
# 免费版密钥以 :fx 结尾，每月 50 万字符
DEEPL_API_KEY=your-deepl-api-key
