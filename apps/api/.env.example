# QuantFi API 环境变量配置

# 数据库
DATABASE_URL="postgresql://quantfi:quantfi123@localhost:5433/quantfi"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 密钥（生产环境请使用强密钥）
JWT_SECRET=your-jwt-secret-key-change-in-production

# API Key 加密密钥（生产环境请使用强密钥）
ENCRYPTION_KEY=your-encryption-key-change-in-production

# API 端口
API_PORT=4001

# Freqtrade 配置
FREQTRADE_API_URL=http://localhost:8080
FREQTRADE_JWT_SECRET=your-freqtrade-jwt-secret

# Webhook 签名密钥（用于验证 Freqtrade 发来的信号）
# 生产环境请使用强随机密钥：openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-change-in-production

# Resend 邮件服务
# 从 https://resend.com/api-keys 获取
RESEND_API_KEY=re_xxxxxxxxxx
# 发件人邮箱（需要在 Resend 中验证域名）
EMAIL_FROM=noreply@hoot.cool

# Telegram Bot
# Bot Token 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TG Bot HTTP API 地址
TG_BOT_API_URL=http://localhost:4002

# 运行环境
NODE_ENV=development
