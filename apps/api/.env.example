# ====================================
# QuantFi 后端 API 环境变量配置模板
# ====================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写真实配置值（不要提交 .env 到 git）
# 3. 生产环境请更换所有密钥

# ------------------------------------
# 应用配置
# ------------------------------------
NODE_ENV=development
PORT=4001

# ------------------------------------
# 数据库配置（PostgreSQL）
# ------------------------------------
DATABASE_URL=postgresql://quantfi:quantfi_dev_password@localhost:5433/quantfi

# 连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------
# Redis 配置
# ------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=quantfi_redis_password
REDIS_DB=0

# ------------------------------------
# JWT 认证配置
# ------------------------------------
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------
# API Key 加密配置
# ------------------------------------
# 用于加密存储用户的交易所 API Key
# 必须是 32 字节（256位）的密钥
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change-in-production

# ------------------------------------
# DigitalOcean API（VPS 编排）
# ------------------------------------
# API Token（从 DigitalOcean 控制台获取）
DO_API_TOKEN=your-do-api-token-here

# 沙盒模式（开发环境建议启用，不会真实创建 VPS）
DO_SANDBOX_MODE=true

# 默认配置
DO_DEFAULT_REGION=sgp1
DO_DEFAULT_SIZE=s-1vcpu-1gb
DO_DEFAULT_IMAGE=docker-20-04

# ------------------------------------
# S3 对象存储（数据备份）
# ------------------------------------
# 预留，后续集成时启用
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ------------------------------------
# VPS 网络安全配置
# ------------------------------------
# SSH 允许访问的 IP 白名单（逗号分隔，用于管理员 SSH 访问）
# 示例: 1.2.3.4,5.6.7.8/24
# 注意: 留空或设为 0.0.0.0/0 将允许所有 IP（仅开发环境使用）
VPS_SSH_ALLOWED_IPS=

# VPS API 端口（Freqtrade API）
VPS_API_PORT=8080

# 是否启用 iptables 防火墙（建议生产环境启用）
VPS_ENABLE_IPTABLES=true

# 是否启用 fail2ban 防护（建议生产环境启用）
VPS_ENABLE_FAIL2BAN=true

# API 端点（VPS 心跳上报地址）
API_ENDPOINT=http://your-api-server:4001

# ------------------------------------
# 日志配置
# ------------------------------------
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# ------------------------------------
# 限流配置
# ------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ------------------------------------
# CORS 配置
# ------------------------------------
CORS_ORIGIN=http://localhost:3001

# ------------------------------------
# 开发环境保护开关
# ------------------------------------
# 开发模式：禁止自动创建 VPS（避免误操作产生费用）
# 设为 true 时，所有 VPS 创建操作都会被阻止
# 生产环境必须设为 false
DEVELOPMENT_MODE=true

# ------------------------------------
# GameFi 功能开关
# ------------------------------------
# 代币质押开关（B 类质押），设为 true 启用
ENABLE_TOKEN_STAKING=false

# ------------------------------------
# AI 功能配置
# ------------------------------------
# DeepSeek API（用于单笔持仓解读）
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API（用于账户级交易分析和策略生成）
# 从 https://platform.openai.com 获取
OPENAI_API_KEY=your-openai-api-key-here
