  id String @id @default("default")

  // 返佣比例配置（百分比）
  level1Rate Decimal @default(10) @db.Decimal(5, 2) @map("level1_rate") // 一级返佣 10%
  level2Rate Decimal @default(5)  @db.Decimal(5, 2) @map("level2_rate") // 二级返佣 5%
  level3Rate Decimal @default(2)  @db.Decimal(5, 2) @map("level3_rate") // 三级返佣 2%

  // 返佣类型：subscription（订阅费返佣）、gas_fee（燃油费返佣）
  enabledTypes String[] @default(["subscription"]) @map("enabled_types")

  // 是否启用
  isActive Boolean @default(true) @map("is_active")

  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("referral_configs")
}
