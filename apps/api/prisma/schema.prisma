  details  String // JSON 格式详情

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([signalId])
  @@map("risk_logs")
}

// DCA 补仓日志
model DcaLog {
  id         String   @id @default(uuid())
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id])
  userId     String   @map("user_id")

  dcaNumber    Int     // 第几次补仓
  triggerPrice Decimal @db.Decimal(18, 8) @map("trigger_price") // 触发价格
  dcaAmount    Decimal @db.Decimal(18, 8) @map("dca_amount")    // 补仓金额 USDT
  newAvgPrice  Decimal @db.Decimal(18, 8) @map("new_avg_price") // 新均价
