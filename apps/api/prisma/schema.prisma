model strategies {
  id                      String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  owner_type              String                  @default("system") @db.VarChar(20)
  owner_id                String?                 @db.Uuid
  uploader_id             String?                 @db.Uuid
  name                    String                  @db.VarChar(100)
  description             String?
  content                 String
  config                  Json?                   @default("{}")
  performance_stats       Json?                   @default("{\"live\": {\"win_rate\": 0, \"total_pnl\": 0, \"last_updated\": null, \"total_trades\": 0}, \"backtest\": {\"win_rate\": 0, \"max_drawdown\": 0, \"sharpe_ratio\": 0, \"total_trades\": 0, \"profit_factor\": 0}}")
  is_public               Boolean                 @default(false)
  is_active               Boolean                 @default(true)
  version                 Int                     @default(1)
  review_status           String                  @default("pending") @db.VarChar(20)
  reviewed_by             String?                 @db.Uuid
  reject_reason           String?
  auto_check_passed       Boolean?
  auto_check_warnings     Json?                   @default("[]")
  tier                    String                  @default("bronze") @db.VarChar(20)
  total_users             Int                     @default(0)
  total_profit            Decimal                 @default(0) @db.Decimal(18, 8)
  avg_win_rate            Decimal                 @default(0) @db.Decimal(5, 4)
  avg_sharpe_ratio        Decimal                 @default(0) @db.Decimal(8, 4)
  revenue_share_enabled   Boolean                 @default(false)
  revenue_share_rate      Decimal                 @default(0) @db.Decimal(5, 4)
  backtest_data           Json?                   @default("{}")
  backtest_total_return   Decimal?                @db.Decimal(18, 8)
  backtest_max_drawdown   Decimal?                @db.Decimal(8, 4)
  backtest_win_rate       Decimal?                @db.Decimal(5, 4)
  backtest_sharpe_ratio   Decimal?                @db.Decimal(8, 4)
  backtest_total_trades   Int?
  backtest_period_start   DateTime?               @db.Timestamptz(6)
  backtest_period_end     DateTime?               @db.Timestamptz(6)
  has_backtest            Boolean                 @default(false)
  reviewed_at             DateTime?               @db.Timestamptz(6)
  last_performance_calc   DateTime?               @db.Timestamptz(6)
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                @default(now()) @db.Timestamptz(6)
  uploader                users?                  @relation("StrategyUploader", fields: [uploader_id], references: [id])
  backtests               backtests[]
  trade_history           trade_history[]
  user_strategy_configs   user_strategy_configs[]
  strategy_revenue_logs   strategy_revenue_logs[]

  @@index([owner_type, owner_id], map: "idx_strategies_owner")
  @@index([review_status], map: "idx_strategies_review_status")
  @@index([uploader_id], map: "idx_strategies_uploader")
}

