model strategy_revenue_logs {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  strategy_id        String      @db.Uuid
  user_id            String      @db.Uuid
  uploader_id        String      @db.Uuid
  base_amount        Decimal     @db.Decimal(18, 8)
  revenue_amount     Decimal     @db.Decimal(18, 8)
  gas_fee_amount     Decimal?    @db.Decimal(18, 8)
  share_rate         Decimal?    @db.Decimal(5, 4)
  revenue_share_rate Decimal     @db.Decimal(5, 4)
  share_amount       Decimal?    @db.Decimal(18, 8)
  platform_deduction Decimal?    @db.Decimal(18, 8)
  status             String      @default("pending") @db.VarChar(20)
  withdrawn          Boolean     @default(false)
  withdrawal_id      String?     @db.Uuid
  billing_log_id     String?     @db.Uuid
  settled_at         DateTime?   @db.Timestamptz(6)
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  strategy           strategies  @relation(fields: [strategy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([strategy_id], map: "idx_strategy_revenue_logs_strategy")
  @@index([user_id], map: "idx_strategy_revenue_logs_user")
  @@index([uploader_id], map: "idx_strategy_revenue_logs_uploader")
  @@index([created_at], map: "idx_strategy_revenue_logs_created")
}

// ==================== Telegram 登录日志 ====================

/// Telegram 登录日志表
model telegram_login_logs {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  telegram_id    BigInt
  user_id        String?   @db.Uuid
  auth_date      DateTime? @db.Timestamptz(6)
  init_data_hash String?   @db.VarChar(100)
  ip_address     String?   @db.Inet
  status         String    @default("success") @db.VarChar(20)
  error_message  String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([telegram_id], map: "idx_telegram_login_logs_telegram")
  @@index([user_id], map: "idx_telegram_login_logs_user")
  @@index([created_at], map: "idx_telegram_login_logs_created")
}

// ==================== 代币链上提现 ====================

/// 代币链上提现记录表
model token_onchain_withdrawals {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String    @db.Uuid
  amount       Decimal   @db.Decimal(18, 8)
  fee          Decimal   @default(0) @db.Decimal(18, 8)
  chain        String?   @default("BSC") @db.VarChar(20)
  to_address   String    @db.VarChar(100)
  tx_hash      String?   @db.VarChar(100)
  status       String    @default("pending") @db.VarChar(20)
  reviewed_by  String?   @db.Uuid
  reviewed_at  DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_token_onchain_withdrawals_user")
  @@index([status], map: "idx_token_onchain_withdrawals_status")
  @@index([created_at], map: "idx_token_onchain_withdrawals_created")
}

// ==================== 代币回购记录 ====================

/// 代币回购记录表
model token_buybacks {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usdt_spent  Decimal  @db.Decimal(18, 8)
  qfi_bought  Decimal  @db.Decimal(18, 8)
  price       Decimal  @db.Decimal(18, 8)
  tx_hash     String?  @db.VarChar(100)
  bought_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([bought_at], map: "idx_token_buybacks_bought_at")
}
