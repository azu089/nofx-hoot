  @@map("agents")
}

// 代理商佣金记录
model AgentCommission {
  id      String @id @default(uuid())
  agentId String @map("agent_id")
  agent   Agent  @relation(fields: [agentId], references: [id])

  // 来源用户
  userId String @map("user_id")

  // 佣金类型：subscription（订阅分成）、gas_fee（燃油费分成）
  type String

  // 来源金额（用户产生的收入）
  sourceAmount Decimal @db.Decimal(18, 8) @map("source_amount")
  // 佣金比例
  commissionRate Decimal @db.Decimal(5, 4) @map("commission_rate")
  // 佣金金额
  commissionAmount Decimal @db.Decimal(18, 8) @map("commission_amount")

