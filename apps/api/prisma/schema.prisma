  requestedAmountUsdt Decimal @db.Decimal(18, 8) @map("requested_amount_usdt")
  requestedPrice Decimal? @db.Decimal(18, 8) @map("requested_price")

  // 执行结果
  executedAmount Decimal? @db.Decimal(18, 8) @map("executed_amount")
  executedPrice Decimal? @db.Decimal(18, 8) @map("executed_price")
  executedVolumeUsdt Decimal? @db.Decimal(18, 8) @map("executed_volume_usdt")

