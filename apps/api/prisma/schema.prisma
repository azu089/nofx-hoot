// QuantFi MVP Database Schema
// 基于开发顺序.md Phase 3.1 设计

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== MVP 必需表 ==========

// 用户
model User {
  id        String   @id @default(uuid())
  email     String?  @unique  // 可选：邮箱登录用户必填，钱包/TG登录用户可选
  password  String?           // 可选：邮箱登录用户必填，钱包/TG登录用户无需密码
  nickname  String?

  // 邮箱验证
  emailVerified Boolean @default(false) @map("email_verified")
  verificationCode String? @map("verification_code")
  verificationExpiry DateTime? @map("verification_expiry")

  // 管理员标识
  isAdmin Boolean @default(false) @map("is_admin")

  // 余额 (平台内部余额，非交易所余额)
  usdtBalance Decimal @default(0) @db.Decimal(18, 8) @map("usdt_balance")
  hootBalance Decimal @default(0) @db.Decimal(18, 8) @map("hoot_balance")
  pointBalance Decimal @default(0) @db.Decimal(18, 8) @map("point_balance") // 点卡余额（1:1 USDT）

  // 账户状态
  status String @default("active") // active, frozen, banned

  // HOOT 空投余额（Vesting 机制）
  lockedBalance    Decimal @default(0) @db.Decimal(18, 8) @map("locked_balance")    // 锁定中（释放中）
  availableBalance Decimal @default(0) @db.Decimal(18, 8) @map("available_balance") // 可用（可提取）
  lastVestingAt    DateTime? @map("last_vesting_at")  // 上次释放时间

  // 邀请关系
  inviteCode    String?  @unique @map("invite_code")
  invitedBy     String?  @map("invited_by")
  inviter       User?    @relation("Referral", fields: [invitedBy], references: [id])
  invitees      User[]   @relation("Referral")

  // Telegram 绑定
  telegramId    String?  @unique @map("telegram_id")
  telegramUsername String? @map("telegram_username")

  // 钱包绑定 (Web3 登录)
  walletAddress String? @unique @map("wallet_address")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 代理商关联（如果用户是代理商的下级）
  agentId String? @map("agent_id")
  agent   Agent?  @relation("AgentUsers", fields: [agentId], references: [id])

  // 关系
  apiKeys            ApiKey[]
  positions          Position[]
  subscriptions      StrategySubscription[]
  transactions       Transaction[]
  withdrawRequests   WithdrawRequest[]
  depositAddresses   DepositAddress[]
  referralRewards    ReferralReward[]
  stakingRecords     StakingRecord[]
  notifications      Notification[]
  tradingConfig      UserTradingConfig?
  airdrops           Airdrop[]
  pointCardRecords   PointCardRecord[]
  gasFeeRecords      GasFeeRecord[]

  @@index([status])
  @@index([agentId])
  @@map("users")
}

// ========== 空投系统 ==========

// 空投记录（链下代币）
model Airdrop {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  // 空投类型: register, bind_tg, referral, trading_profit, checkin
  type        String
  amount      Decimal  @db.Decimal(18, 8)  // 空投数量
  balance     Decimal  @db.Decimal(18, 8)  // 空投后总余额

  // 来源信息
  source      String?  // 来源说明（如：邀请人ID，交易ID等）
  sourceId    String?  @map("source_id") // 关联记录ID

  // Vesting 释放
  vestingDays   Int      @default(30) @map("vesting_days")  // 释放天数
  vestingStart  DateTime @default(now()) @map("vesting_start")  // 开始释放时间
  releasedAmount Decimal @default(0) @db.Decimal(18, 8) @map("released_amount") // 已释放数量

  // 状态: pending, confirmed, vesting, completed, cancelled
  status      String   @default("pending")
  txHash      String?  @map("tx_hash") // 上链后的交易哈希

  createdAt   DateTime @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([type])
  @@map("airdrops")
}

// 账户绑定码（用于跨登录方式账户绑定）
model BindingCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")

  code      String   @unique  // 6位绑定码
  type      String   // telegram, wallet, email
  expiresAt DateTime @map("expires_at")  // 5分钟有效期
  used      Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([code, type])
  @@map("binding_codes")
}

// 签到记录
model CheckinRecord {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")

  date        DateTime @db.Date  // 签到日期
  streak      Int      @default(1) // 连续签到天数
  reward      Decimal  @db.Decimal(18, 8)  // 获得的 HOOT 奖励

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("checkin_records")
}

// 交易所 API Key (核心)
model ApiKey {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  exchange String // binance, okx, bybit
  label    String

  // 加密存储 (AES-256-GCM)
  encryptedKey    String @map("encrypted_key")
  encryptedSecret String @map("encrypted_secret")
  iv              String
  authTag         String @map("auth_tag")
  secretIv        String? @map("secret_iv")
  secretAuthTag   String? @map("secret_auth_tag")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}

// 策略
model Strategy {
  id          String  @id @default(uuid())
  name        String
  description String
  freqtradeId String  @unique @map("freqtrade_id") // 对应 Freqtrade 策略名

  // 展示信息
  imageUrl    String? @map("image_url")  // 策略图标
  riskLevel   String  @default("medium") @map("risk_level") // low, medium, high
  tags        String[] @default([])  // 标签：AI, 趋势, 网格等

  // 收益统计（定期计算更新）
  return7d    Decimal? @db.Decimal(10, 4) @map("return_7d")   // 7天收益率
  return30d   Decimal? @db.Decimal(10, 4) @map("return_30d")  // 30天收益率
  return90d   Decimal? @db.Decimal(10, 4) @map("return_90d")  // 90天收益率
  maxDrawdown Decimal? @db.Decimal(10, 4) @map("max_drawdown") // 最大回撤
  winRate     Decimal? @db.Decimal(5, 2) @map("win_rate")     // 胜率
  totalTrades Int      @default(0) @map("total_trades")       // 总交易次数

  // 是否在首页展示
  isFeatured  Boolean @default(false) @map("is_featured")
  sortOrder   Int     @default(0) @map("sort_order")  // 排序权重

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  subscriptions StrategySubscription[]
  signals       Signal[]

  @@map("strategies")
}

// 策略订阅 (用户 <-> 策略 多对多)
model StrategySubscription {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  strategyId String   @map("strategy_id")
  strategy   Strategy @relation(fields: [strategyId], references: [id])

  // === 基础配置 ===
  apiKeyId       String  @map("api_key_id") // 使用哪个 API Key
  amountPerTrade Decimal @db.Decimal(18, 8) @map("amount_per_trade") // 每单金额
  maxPositions   Int     @default(3) @map("max_positions")

  // === 交易类型配置 ===
  tradingType    String  @default("spot") @map("trading_type") // spot, futures
  leverage       Int     @default(1) // 杠杆倍数（合约专用）
  marginMode     String  @default("cross") @map("margin_mode") // cross, isolated（合约专用）
  direction      String  @default("both") // long, short, both（策略方向）

  // === 交易对配置 ===
  tradingPairs   String[] @default([]) @map("trading_pairs") // 交易对列表，空=跟随策略

  // === 基础风控 ===
  slippageTolerance Decimal @default(0.5) @db.Decimal(5, 2) @map("slippage_tolerance") // 滑点容忍度(%)
  autoClose         Boolean @default(true) @map("auto_close") // 收到卖出信号自动平仓
  stopLossPercent   Decimal? @db.Decimal(5, 2) @map("stop_loss_percent") // 止损百分比
  takeProfitPercent Decimal? @db.Decimal(5, 2) @map("take_profit_percent") // 止盈百分比

  // === 移动止损 ===
  trailingStopEnabled    Boolean @default(false) @map("trailing_stop_enabled")
  trailingStopActivation Decimal? @db.Decimal(5, 2) @map("trailing_stop_activation") // 激活盈利(%)
  trailingStopCallback   Decimal? @db.Decimal(5, 2) @map("trailing_stop_callback") // 回撤比例(%)

  // === DCA 补仓配置 ===
  dcaEnabled    Boolean @default(false) @map("dca_enabled")
  dcaMaxCount   Int     @default(3) @map("dca_max_count") // 最大补仓次数
  dcaTrigger    Decimal @default(5) @db.Decimal(5, 2) @map("dca_trigger") // 触发跌幅(%)
  dcaMultiplier Decimal @default(1.5) @db.Decimal(5, 2) @map("dca_multiplier") // 补仓倍率

  // === 防瀑布保护 ===
  waterfallProtection       Boolean @default(true) @map("waterfall_protection")
  waterfallTriggerPercent   Decimal @default(15) @db.Decimal(5, 2) @map("waterfall_trigger_percent") // 触发跌幅(%)

  // === 黑天鹅保护 ===
  blackSwanProtection Boolean @default(false) @map("black_swan_protection")
  blackSwanType       String  @default("account_loss") @map("black_swan_type") // account_loss, coin_drop
  blackSwanTrigger    Decimal @default(10) @db.Decimal(5, 2) @map("black_swan_trigger") // 触发阈值(%)
  blackSwanAction     String  @default("close_all") @map("black_swan_action") // close_all, close_half, pause

  // === 单日亏损限制 ===
  dailyMaxLossEnabled Boolean @default(false) @map("daily_max_loss_enabled")
  dailyMaxLossPercent Decimal @default(20) @db.Decimal(5, 2) @map("daily_max_loss_percent") // 单日最大亏损(%)

  // === 重试配置 ===
  maxRetries     Int @default(3) @map("max_retries") // 最大重试次数
  retryDelayMs   Int @default(1000) @map("retry_delay_ms") // 重试间隔(ms)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // 关系
  positions Position[]

  @@unique([userId, strategyId])
  @@map("strategy_subscriptions")
}

// 交易信号 (从 Freqtrade 接收)
model Signal {
  id         String   @id @default(uuid())
  strategyId String   @map("strategy_id")
  strategy   Strategy @relation(fields: [strategyId], references: [id])

  symbol String // BTC/USDT
  side   String // buy, sell
  price  Decimal @db.Decimal(18, 8)

  // 信号分发追踪
  distributedAt DateTime? @map("distributed_at")
  subscriberCount Int @default(0) @map("subscriber_count")
  executedCount   Int @default(0) @map("executed_count")
  failedCount     Int @default(0) @map("failed_count")

  createdAt DateTime @default(now()) @map("created_at")

  executions SignalExecution[]

  @@map("signals")
}

// 信号执行记录（追踪每个用户的信号执行状态）
model SignalExecution {
  id       String @id @default(uuid())
  signalId String @map("signal_id")
  signal   Signal @relation(fields: [signalId], references: [id])
  userId   String @map("user_id")

  // 执行状态
  status String @default("pending") // pending, queued, executing, success, failed, skipped

  // 执行详情
  exchange     String?
  orderId      String? @map("order_id")
  executedPrice Decimal? @db.Decimal(18, 8) @map("executed_price")
  executedAmount Decimal? @db.Decimal(18, 8) @map("executed_amount")

  // 失败信息
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")

  // 跳过原因
  skipReason String? @map("skip_reason") // no_api_key, insufficient_balance, max_positions

  // 时间追踪
  queuedAt   DateTime? @map("queued_at")
  startedAt  DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([signalId, userId])
  @@index([signalId])
  @@index([userId, status])
  @@map("signal_executions")
}

// 持仓
model Position {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  exchange String
  symbol   String
  side     String // long, short

  entryPrice Decimal @db.Decimal(18, 8) @map("entry_price")
  amount     Decimal @db.Decimal(18, 8)

  // 交易所返回的订单ID
  exchangeOrderId String? @map("exchange_order_id")

  // 关联
  apiKeyId       String? @map("api_key_id")
  subscriptionId String? @map("subscription_id")
  subscription   StrategySubscription? @relation(fields: [subscriptionId], references: [id])
  signalId       String? @map("signal_id")

  status      String    @default("open") // open, closed, failed
  closedAt    DateTime? @map("closed_at")
  exitPrice   Decimal?  @db.Decimal(18, 8) @map("exit_price")
  closePrice  Decimal?  @db.Decimal(18, 8) @map("close_price")
  closeReason String?   @map("close_reason") // stop_loss, take_profit, trailing_stop, signal, manual, black_swan, daily_loss_limit
  pnl         Decimal?  @db.Decimal(18, 8)
  realizedPnl Decimal?  @db.Decimal(18, 8) @map("realized_pnl")

  // DCA 补仓
  dcaCount   Int       @default(0) @map("dca_count")
  lastDcaAt  DateTime? @map("last_dca_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dcaLogs DcaLog[]

  @@map("positions")
}

// ========== Phase 4: 钱包与资金 ==========

// 交易记录
model Transaction {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  type   String // deposit, withdraw, fee, reward, referral
  asset  String // USDT, HOOT
  amount Decimal @db.Decimal(18, 8)

  // 幂等性：唯一订单号
  uniqueOrderId String @unique @map("unique_order_id")

  status    String  @default("pending") // pending, completed, failed
  txHash    String? @map("tx_hash") // 链上交易哈希
  remark    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, type])
  @@map("transactions")
}

// 充值地址
model DepositAddress {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  chain   String // BSC, ETH, TRC20
  asset   String // USDT, HOOT
  address String

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, chain, asset])
  @@map("deposit_addresses")
}

// 提现申请
model WithdrawRequest {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  asset   String // USDT, HOOT
  amount  Decimal @db.Decimal(18, 8)
  fee     Decimal @db.Decimal(18, 8) @default(0)
  chain   String // BSC, ETH, TRC20
  address String // 提现目标地址

  status    String  @default("pending") // pending, approved, rejected, completed
  txHash    String? @map("tx_hash")
  remark    String?

  processedAt DateTime? @map("processed_at")
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("withdraw_requests")
}

// ========== Phase 5: 代理商系统 ==========

// 返佣记录
model ReferralReward {
  id     String @id @default(uuid())
  userId String @map("user_id") // 获得返佣的用户
  user   User   @relation(fields: [userId], references: [id])

  fromUserId String  @map("from_user_id") // 被邀请人
  type       String // subscription, trading
  amount     Decimal @db.Decimal(18, 8)
  asset      String // USDT, HOOT

  uniqueOrderId String @unique @map("unique_order_id") // 幂等性
  status        String @default("pending") // pending, paid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("referral_rewards")
}

// ========== Phase 6: 质押系统 ==========

// 质押记录（只支持 HOOT 单币质押）
model StakingRecord {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // 质押金额
  amount Decimal @db.Decimal(18, 8)

  // 质押时间
  stakedAt   DateTime  @default(now()) @map("staked_at")
  unstakedAt DateTime? @map("unstaked_at")

  // 锁定期配置
  lockDays   Int @default(0) @map("lock_days") // 0=活期，>0=定期
  lockUntil  DateTime? @map("lock_until")

  // 权重（根据锁定时间计算，活期1.0，定期最高3.0）
  weight Decimal @default(1) @db.Decimal(5, 2)

  // 累计获得分红
  totalDividends Decimal @default(0) @db.Decimal(18, 8) @map("total_dividends")

  // 状态
  status String @default("active") // active, unstaked, locked

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dividends DividendRecord[]

  @@index([userId, status])
  @@map("staking_records")
}

// 分红记录
model DividendRecord {
  id        String @id @default(uuid())
  stakingId String @map("staking_id")
  staking   StakingRecord @relation(fields: [stakingId], references: [id])

  // 分红周期
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  // 快照数据
  stakedAmount  Decimal @db.Decimal(18, 8) @map("staked_amount")
  weightedAmount Decimal @db.Decimal(18, 8) @map("weighted_amount")
  totalWeighted Decimal @db.Decimal(18, 8) @map("total_weighted")

  // 分红金额
  dividendAmount Decimal @db.Decimal(18, 8) @map("dividend_amount")
  asset          String // USDT

  status    String @default("pending") // pending, paid
  paidAt    DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([stakingId])
  @@map("dividend_records")
}

// 分红池记录（周分红，来源为燃油费）
model DividendPool {
  id String @id @default(uuid())

  // 周期（每周一 00:00 ~ 周日 23:59）
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  weekNumber  Int      @map("week_number") // 年度周数

  // 燃油费来源
  gasFeeTotal Decimal @db.Decimal(18, 8) @map("gas_fee_total") // 本周燃油费总额
  gasFeeCount Int     @default(0) @map("gas_fee_count")        // 燃油费笔数

  // 分红池金额（燃油费 * 分红比例）
  dividendRate   Decimal @default(0.5) @db.Decimal(5, 2) @map("dividend_rate") // 分红比例（如50%进入分红池）
  totalAmount    Decimal @db.Decimal(18, 8) @map("total_amount")
  distributedAmount Decimal @default(0) @db.Decimal(18, 8) @map("distributed_amount")
  remainingAmount   Decimal @default(0) @db.Decimal(18, 8) @map("remaining_amount")

  // 全网质押数据快照
  totalStaked   Decimal @db.Decimal(18, 8) @map("total_staked")   // 总质押量
  totalWeighted Decimal @db.Decimal(18, 8) @map("total_weighted") // 加权质押量
  stakerCount   Int     @default(0) @map("staker_count")          // 质押人数

  // 单位权重分红
  dividendPerWeight Decimal? @db.Decimal(18, 12) @map("dividend_per_weight")

  status    String @default("collecting") // collecting, pending, distributing, distributed
  distributedAt DateTime? @map("distributed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([periodStart, periodEnd])
  @@index([weekNumber])
  @@index([status])
  @@map("dividend_pools")
}

// ========== Phase 7: 计费与通知 ==========

// 计费日志（幂等性保证）
model BillingLog {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type   String // GAS_FEE, SUBSCRIPTION, WITHDRAW_FEE
  amount String // 使用字符串存储，避免精度问题

  // 幂等性：唯一订单号
  uniqueOrderId String @unique @map("unique_order_id")

  description String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("billing_logs")
}

// 通知记录
model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  type     String // signal_received, position_opened, etc.
  title    String
  message  String
  channels String // 逗号分隔: in_app,telegram,email

  read Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@map("notifications")
}

// 风控拒绝日志
model RiskLog {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  signalId String? @map("signal_id") // 可选，黑天鹅/日亏损触发时无信号
  reason   String // max_positions_reached, symbol_already_open, black_swan, daily_loss_limit, etc.
  details  String // JSON 格式详情

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([signalId])
  @@map("risk_logs")
}

// DCA 补仓日志
model DcaLog {
  id         String   @id @default(uuid())
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id])
  userId     String   @map("user_id")

