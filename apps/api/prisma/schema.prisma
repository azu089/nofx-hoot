model trade_history {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String      @db.Uuid
  instance_id    String?     @db.Uuid
  strategy_id    String?     @db.Uuid
  exchange       String      @db.VarChar(50)
  symbol         String      @db.VarChar(30)
  side           String      @db.VarChar(10)
  order_type     String      @db.VarChar(20)
  entry_price    Decimal?    @db.Decimal(18, 8)
  exit_price     Decimal?    @db.Decimal(18, 8)
  quantity       Decimal     @db.Decimal(18, 8)
  leverage       Int?        @default(1) @db.SmallInt
  pnl            Decimal?    @db.Decimal(18, 8)
  pnl_percentage Decimal?    @db.Decimal(8, 4)
  gas_fee        Decimal?    @default(0) @db.Decimal(18, 8)
  status         String      @default("open") @db.VarChar(20)
  opened_at      DateTime    @default(now()) @db.Timestamptz(6)
  closed_at      DateTime?   @db.Timestamptz(6)
  sync_data      Json?       @default("{}")
  synced_at      DateTime?   @db.Timestamptz(6)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  instances      instances?  @relation(fields: [instance_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  strategies     strategies? @relation(fields: [strategy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([instance_id], map: "idx_trade_history_instance")
  @@index([opened_at], map: "idx_trade_history_opened")
  @@index([status], map: "idx_trade_history_status")
  @@index([symbol], map: "idx_trade_history_symbol")
