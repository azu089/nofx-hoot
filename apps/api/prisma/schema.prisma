// 代理商分红池（月度）
model AgentDividendPool {
  id String @id @default(uuid())

  // 周期
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  monthNumber String   @map("month_number") // 2026-02

  // 燃油费来源
  gasFeeTotal Decimal @db.Decimal(18, 8) @map("gas_fee_total") // 本月燃油费总额
  poolRate    Decimal @default(0.10) @db.Decimal(5, 4) @map("pool_rate") // 进入池子比例（如 0.10 = 10%）
  poolAmount  Decimal @db.Decimal(18, 8) @map("pool_amount") // 池子金额（USDT）

  // 回购信息
  hootPrice   Decimal? @db.Decimal(18, 8) @map("hoot_price")  // 回购均价
  hootAmount  Decimal? @db.Decimal(18, 8) @map("hoot_amount") // 回购 HOOT 数量

  // 分配
  totalTradeVolume   Decimal @default(0) @db.Decimal(18, 8) @map("total_trade_volume") // 参与代理的总交易量
  distributedAmount  Decimal @default(0) @db.Decimal(18, 8) @map("distributed_amount")
  participantCount   Int     @default(0) @map("participant_count") // 参与代理数

  // 状态: collecting(收集中), pending(待分配), distributing(分配中), distributed(已分配)
  status        String    @default("collecting")
  distributedAt DateTime? @map("distributed_at")

