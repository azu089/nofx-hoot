// ========== 管理后台 ==========

// 管理员账号
model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
  email    String? @unique
  nickname String?

  // 角色
  role     String @default("admin") // super_admin, admin, operator, finance, readonly, agent

  // 状态
  isActive Boolean @default(true) @map("is_active")

  // 2FA (Google Authenticator)
  totpSecret  String?  @map("totp_secret")  // TOTP 密钥（加密存储）
  totpEnabled Boolean  @default(false) @map("totp_enabled")

  // 登录安全
  loginAttempts Int       @default(0) @map("login_attempts")  // 连续失败次数
  lockedUntil   DateTime? @map("locked_until")                // 锁定截止时间

  // 登录信息
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String?   @map("last_login_ip")

  // 代理商关联（如果角色是 agent）
  agentUserId String? @unique @map("agent_user_id")  // 关联的用户ID

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关系
  operationLogs AdminOperationLog[]

  @@map("admins")
}

// 管理员操作日志
model AdminOperationLog {
  id      String @id @default(uuid())
  adminId String @map("admin_id")
  admin   Admin  @relation(fields: [adminId], references: [id])

  // 操作信息
  action     String // login, create, update, delete, approve, reject
  module     String // user, strategy, withdraw, announcement, config
  targetId   String? @map("target_id") // 操作目标ID
  targetType String? @map("target_type") // 操作目标类型

  // 详情
  description String?
  details     String? @db.Text // JSON 格式的详细变更
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")

  // 结果
  result String @default("success") // success, failed

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([module, action])
  @@map("admin_operation_logs")
}

// 审计日志（系统级操作追踪）
model AuditLog {
  id          String   @id @default(uuid())

  // 操作者信息
  actorId     String   @map("actor_id")
  actorType   String   @map("actor_type") // admin, system, user

  // 操作信息
  action      String   // 操作类型
  resourceType String  @map("resource_type") // 资源类型
  resourceId  String?  @map("resource_id") // 资源ID

  // 详情
  details     String?  @db.Text
  metadata    Json?    // 额外元数据

  // IP 和设备信息
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// 公告
model Announcement {
  id    String @id @default(uuid())

  // 多语言内容 (JSONB)
  // 格式: {"zh-CN": "内容", "en": "Content", "zh-HK": "內容", "ja": "コンテンツ", ...}
  titleI18n   Json @default("{}") @map("title_i18n")
  contentI18n Json @default("{}") @map("content_i18n")

  // 兼容旧字段（默认语言）
  title   String @default("")
  content String @default("") @db.Text

  // 类型和位置
  type     String @default("system") // system, activity, maintenance, emergency
  position String @default("all") // home, popup, marquee, all

  // 媒体
  coverImage String? @map("cover_image")
  link       String?

  // 发布设置
  status      String @default("draft") // draft, published, offline
  publishedAt DateTime? @map("published_at")
  expiredAt   DateTime? @map("expired_at")
  priority    Int @default(0) // 排序权重

  // 推送
  pushNotification Boolean @default(false) @map("push_notification")

  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("announcements")
}

// 跑马灯
