  name          String
  email         String @unique
  password      String
  phone         String?
  companyName   String? @map("company_name")

  // 代理商等级：bronze, silver, gold, platinum
  level String @default("bronze")

  // 佣金配置
  commissionRate  Decimal @default(0.10) @db.Decimal(5, 4) @map("commission_rate") // 默认10%
  settlementType  String  @default("weekly") @map("settlement_type") // daily, weekly, monthly

  // 结算账户
  walletAddress String? @map("wallet_address")
  bankAccount   String? @map("bank_account") @db.Text // 加密存储银行信息

