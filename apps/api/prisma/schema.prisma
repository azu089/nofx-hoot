generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model admin_audit_logs {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  admin_id    String   @db.Uuid
  action      String   @db.VarChar(50)
  target_type String?  @db.VarChar(50)
  target_id   String?  @db.Uuid
  details     Json?    @default("{}")
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([action], map: "idx_admin_audit_logs_action")
  @@index([admin_id], map: "idx_admin_audit_logs_admin")
  @@index([created_at], map: "idx_admin_audit_logs_created")
}

model agent_commissions {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agent_id          String    @db.Uuid
  user_id           String    @db.Uuid
  source_type       String    @db.VarChar(30)
  source_id         String?   @db.Uuid
  base_amount       Decimal   @db.Decimal(18, 8)
  commission_rate   Decimal   @db.Decimal(5, 4)
  commission_amount Decimal   @db.Decimal(18, 8)
  status            String    @default("pending") @db.VarChar(20)
  settled_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  agents            agents    @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([agent_id], map: "idx_agent_commissions_agent")
  @@index([status], map: "idx_agent_commissions_status")
  @@index([user_id], map: "idx_agent_commissions_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agents {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code              String              @unique @db.VarChar(20)
  name              String              @db.VarChar(100)
  email             String              @unique @db.VarChar(255)
  parent_agent_id   String?             @db.Uuid
  level             Int                 @default(1) @db.SmallInt
  commission_rate   Decimal             @default(0.1000) @db.Decimal(5, 4)
  total_users       Int                 @default(0)
  total_commission  Decimal             @default(0) @db.Decimal(18, 8)
  status            String              @default("active") @db.VarChar(20)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  agent_commissions  agent_commissions[]
  agent_withdrawals  agent_withdrawals[]
  agents             agents?             @relation("agentsToagents", fields: [parent_agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_agents       agents[]            @relation("agentsToagents")
  users              users[]

  @@index([code], map: "idx_agents_code")
  @@index([parent_agent_id], map: "idx_agents_parent")
}

/// 代理商提现记录
model agent_withdrawals {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agent_id        String    @db.Uuid
  amount          Decimal   @db.Decimal(18, 8)
  fee             Decimal   @default(0) @db.Decimal(18, 8)
  status          String    @default("pending") @db.VarChar(20)  // pending/approved/rejected/completed
  wallet_address  String?   @db.VarChar(255)
  chain           String?   @db.VarChar(20)
  tx_hash         String?   @db.VarChar(255)
  reviewed_by     String?   @db.Uuid
  reviewed_at     DateTime? @db.Timestamptz(6)
  reject_reason   String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  agents          agents    @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?    @relation("agent_withdrawals_reviewed_by", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([agent_id], map: "idx_agent_withdrawals_agent")
  @@index([status], map: "idx_agent_withdrawals_status")
}

model announcements {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title         String    @db.VarChar(200)
  content       String
  type          String    @default("info") @db.VarChar(20)
  is_pinned     Boolean   @default(false)
  display_order Int       @default(0)
  start_at      DateTime  @default(now()) @db.Timestamptz(6)
  end_at        DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([start_at, end_at], map: "idx_announcements_active")
}

model api_keys {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  exchange         String    @db.VarChar(50)
  label            String?   @db.VarChar(100)
  encrypted_blob   Bytes
  iv               Bytes
  auth_tag         Bytes
  permissions      Json?     @default("{\"spot\": false, \"futures\": true, \"withdraw\": false}")
  is_active        Boolean   @default(true)
  last_verified_at DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([exchange], map: "idx_api_keys_exchange")
  @@index([user_id], map: "idx_api_keys_user")
}

model backtests {
  id               String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String     @db.Uuid
  strategy_id      String     @db.Uuid
  config           Json       @default("{\"pairs\": [\"BTC/USDT\", \"ETH/USDT\"], \"timerange\": \"20240101-20241231\", \"stake_amount\": 100, \"stake_currency\": \"USDT\"}")
  results          Json?
  total_trades     Int?
  win_rate         Decimal?   @db.Decimal(5, 2)
  profit_total     Decimal?   @db.Decimal(18, 8)
  profit_percent   Decimal?   @db.Decimal(8, 4)
  max_drawdown     Decimal?   @db.Decimal(8, 4)
  sharpe_ratio     Decimal?   @db.Decimal(8, 4)
  status           String     @default("pending") @db.VarChar(20)
  error_message    String?
  started_at       DateTime?  @db.Timestamptz(6)
  completed_at     DateTime?  @db.Timestamptz(6)
  duration_seconds Int?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
  strategies       strategies @relation(fields: [strategy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_backtests_created")
  @@index([status], map: "idx_backtests_status")
  @@index([strategy_id], map: "idx_backtests_strategy")
  @@index([user_id], map: "idx_backtests_user")
}

model billing_logs {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String   @db.Uuid
  unique_order_id String   @unique @db.VarChar(100)
  billing_type    String   @db.VarChar(30)
  amount          Decimal  @db.Decimal(18, 8)
  currency        String   @default("USDT") @db.VarChar(10)
  reference_type  String?  @db.VarChar(50)
  reference_id    String?  @db.Uuid
  description     String?
  status          String   @default("completed") @db.VarChar(20)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_billing_logs_created")
  @@index([billing_type], map: "idx_billing_logs_type")
  @@index([user_id], map: "idx_billing_logs_user")
  @@index([user_id, status], map: "idx_billing_logs_user_status")
  @@index([user_id, billing_type, status], map: "idx_billing_logs_user_type_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deposits {
  id                                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                           String    @db.Uuid
  amount                            Decimal   @db.Decimal(18, 8)
  currency                          String    @default("USDT") @db.VarChar(10)
  method                            String    @db.VarChar(30)
  chain                             String?   @db.VarChar(20)
  from_address                      String?   @db.VarChar(100)
  tx_hash                           String?   @db.VarChar(100)
  block_number                      BigInt?
  confirmations                     Int?      @default(0)
  proof_image_url                   String?   @db.VarChar(500)
  reviewed_by                       String?   @db.Uuid
  reviewed_at                       DateTime? @db.Timestamptz(6)
  status                            String    @default("pending") @db.VarChar(20)
  reject_reason                     String?
  created_at                        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime  @default(now()) @db.Timestamptz(6)
  users_deposits_reviewed_byTousers users?    @relation("deposits_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_deposits_user_idTousers     users     @relation("deposits_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_deposits_created")
  @@index([status], map: "idx_deposits_status")
  @@index([user_id], map: "idx_deposits_user")
}

model instance_backups {
  id                                                            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instance_id                                                   String     @db.Uuid
  user_id                                                       String     @db.Uuid
  backup_type                                                   String     @db.VarChar(20)
  s3_bucket                                                     String     @db.VarChar(100)
  s3_key                                                        String     @db.VarChar(500)
  file_size_bytes                                               BigInt?
  includes                                                      Json?      @default("[\"trades.sqlite\", \"config.json\"]")
  status                                                        String     @default("pending") @db.VarChar(20)
  error_message                                                 String?
  restored_to_instance_id                                       String?    @db.Uuid
  restored_at                                                   DateTime?  @db.Timestamptz(6)
  created_at                                                    DateTime   @default(now()) @db.Timestamptz(6)
  expires_at                                                    DateTime?  @db.Timestamptz(6)
  instances_instance_backups_instance_idToinstances             instances  @relation("instance_backups_instance_idToinstances", fields: [instance_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  instances_instance_backups_restored_to_instance_idToinstances instances? @relation("instance_backups_restored_to_instance_idToinstances", fields: [restored_to_instance_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                         users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([instance_id], map: "idx_instance_backups_instance")
  @@index([status], map: "idx_instance_backups_status")
  @@index([user_id], map: "idx_instance_backups_user")
}

model instances {
  id                                                                   String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                                              String                  @db.Uuid
  droplet_id                                                           String?                 @db.VarChar(50)
  region                                                               String                  @default("sgp1") @db.VarChar(20)
  size                                                                 String                  @default("s-1vcpu-1gb") @db.VarChar(20)
  ip_address                                                           String?                 @db.Inet
  status                                                               String                  @default("pending") @db.VarChar(20)
  last_heartbeat                                                       DateTime?               @db.Timestamptz(6)
  cpu_usage                                                            Decimal?                @db.Decimal(5, 2)
  memory_usage                                                         Decimal?                @db.Decimal(5, 2)
  disk_usage                                                           Decimal?                @db.Decimal(5, 2)
  provisioned_at                                                       DateTime?               @db.Timestamptz(6)
  destroyed_at                                                         DateTime?               @db.Timestamptz(6)
  destroy_reason                                                       String?                 @db.VarChar(100)
  created_at                                                           DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                                           DateTime                @default(now()) @db.Timestamptz(6)
  instance_backups_instance_backups_instance_idToinstances             instance_backups[]      @relation("instance_backups_instance_idToinstances")
  instance_backups_instance_backups_restored_to_instance_idToinstances instance_backups[]      @relation("instance_backups_restored_to_instance_idToinstances")
  users                                                                users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trade_history                                                        trade_history[]
  user_strategy_configs                                                user_strategy_configs[]

  @@index([last_heartbeat], map: "idx_instances_heartbeat")
  @@index([status], map: "idx_instances_status")
}

model revenue_distributions {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  period_start       DateTime @db.Timestamptz(6)
