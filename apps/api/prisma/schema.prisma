// 每日结算记录
model DailySettlement {
  id     String @id @default(uuid())
  userId String @map("user_id")
  date   DateTime @db.Date

  // 余额快照
  startBalance Decimal @db.Decimal(18, 8) @map("start_balance") // 当日起始余额
  endBalance   Decimal @db.Decimal(18, 8) @map("end_balance")   // 当日结束余额

  // 盈亏统计
  realizedPnl   Decimal @db.Decimal(18, 8) @map("realized_pnl")   // 已实现盈亏
  unrealizedPnl Decimal @db.Decimal(18, 8) @map("unrealized_pnl") // 未实现盈亏
  totalPnl      Decimal @db.Decimal(18, 8) @map("total_pnl")      // 总盈亏
  pnlPercent    Decimal @db.Decimal(5, 2) @map("pnl_percent")     // 盈亏百分比

  // 风控状态
  wasLocked Boolean @default(false) @map("was_locked") // 当日是否触发锁定

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_settlements")
}

// ========== 配置管理系统 ==========

